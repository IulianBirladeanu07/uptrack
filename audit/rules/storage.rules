rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profilePictures/{fileName} {
      function isOwnFile() {
        return request.auth != null && fileName == request.auth.uid + '.jpg';
      }

      allow read: if isOwnFile();
      allow create, update: if isOwnFile()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
